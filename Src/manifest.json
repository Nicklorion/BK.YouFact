{
  "manifest_version": 3,
  "name": "YouFact",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "See through the feed: channel credibility scoring and one-click recommendation control for YouTube.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.anthropic.com/*"],
  "action": {
    "default_title": "YouFact settings",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["harvester.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
